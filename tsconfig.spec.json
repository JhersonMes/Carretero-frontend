{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/test-out",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "types": [],
    "paths": {
      "@angular/common/http": [
        "./node_modules/@angular/common/types/http.d.ts"
      ],
      "@angular/core/rxjs-interop": [
        "./node_modules/@angular/core/types/rxjs-interop.d.ts"
      ],
      "@angular/cdk/drag-drop": [
        "./node_modules/@angular/cdk/types/drag-drop.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
